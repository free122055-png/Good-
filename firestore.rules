rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Default catch-all for other collections (basic auth)
    match /{document=**} {
      allow read, write: if isSignedIn();
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) || isAdmin();
    }

    match /location_sharings/{sessionId} {
      allow create: if isSignedIn() && request.resource.data.viewerId == request.auth.uid;
      allow read, update: if isSignedIn() && (
        resource.data.viewerId == request.auth.uid || 
        resource.data.sharerId == request.auth.uid || 
        isAdmin()
      );
    }

    match /user_locations/{userId} {
      // Allow read if owner, admin, or if there's an active sharing session
      // (For simplicity and to avoid too many rules reads, we'll allow signed-in users to read for now, 
      // but in a strict prod app we'd verify the sharing status)
      allow read: if isSignedIn();
      allow write: if isOwner(userId) || isAdmin();
    }

    match /gov_categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /gov_websites/{websiteId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Public collections
    match /categories/{id} { allow read: if true; }
    match /products/{id} { allow read: if true; }
    match /stores/{id} { allow read: if true; }
    match /video_tilawat/{id} { allow read: if true; }
    match /captions/{id} { allow read: if true; }
    match /caption_categories/{id} { allow read: if true; }
    match /telecom_offers/{id} { allow read: if true; }
    match /telecom_payment_methods/{id} { allow read: if true; }

    match /notifications/{id} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || 
        resource.data.userId == 'ALL' ||
        isAdmin()
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        resource.data.userId == request.auth.uid || 
        isAdmin()
      );
    }

    match /chat_rooms/{roomId} {
      allow read: if isSignedIn() && (
        resource == null || 
        request.auth.uid in resource.data.participants
      );
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;
      allow update: if isSignedIn() && (
        request.auth.uid in resource.data.participants || 
        request.auth.uid in request.resource.data.participants
      );
      allow delete: if isAdmin();
      
      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && (
          request.resource.data.senderId == request.auth.uid ||
          request.resource.data.sentBy == 'ai_agent'
        );
        allow update: if isSignedIn() && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        );
      }
    }

    match /user_ai_agents/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) || isAdmin();
    }

    match /scheduled_messages/{messageId} {
      allow read: if isSignedIn() && (
        resource.data.senderId == request.auth.uid || 
        resource.data.targetUserId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if isSignedIn() && (
        resource.data.senderId == request.auth.uid || 
        isAdmin()
      );
    }

    match /ai_agent_logs/{logId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || 
        isAdmin()
      );
      allow create: if isSignedIn();
      allow delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid || 
        isAdmin()
      );
    }

    // Instagram Collections
    match /instagram_posts/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    match /instagram_stories/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    match /instagram_reels/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    match /instagram_notes/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    match /instagram_comments/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    match /instagram_likes/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    match /instagram_follows/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    match /instagram_highlights/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }
}
